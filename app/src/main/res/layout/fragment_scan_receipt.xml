<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/camera_background"
    android:padding="20dp">

    <!-- Top Camera Bar -->
    <ImageButton
        android:id="@+id/btn_close_scanner"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_circle_elevated"
        android:contentDescription="Close"
        android:src="@drawable/ic_arrow_back"
        app:tint="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Scan receipt"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/btn_close_scanner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btn_close_scanner" />

    <TextView
        android:id="@+id/btn_flash"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_circle_elevated"
        android:gravity="center"
        android:text="⚡"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Clean Viewfinder Frame (no static demo receipt data) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_receipt_preview"
        android:layout_width="0dp"
        android:layout_height="260dp"
        android:layout_marginHorizontal="16dp"
        app:cardBackgroundColor="@color/card_background"
        app:cardCornerRadius="18dp"
        app:strokeColor="@color/primary_green"
        app:strokeWidth="2dp"
        app:layout_constraintBottom_toTopOf="@id/tv_scan_hint"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_close_scanner">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_circle_green"
                android:gravity="center"
                android:text="⌗"
                android:textColor="@color/accent_green_text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="Ready to scan receipt"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Tap the capture button below to scan a paper receipt or import a screenshot from your gallery."
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Status Pill -->
    <TextView
        android:id="@+id/tv_scan_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_pill_green"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:text="● Reading text on-device · hold steady"
        android:textColor="@color/primary_green"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/btn_capture_receipt"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Camera Shutter Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_capture_receipt"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginBottom="16dp"
        android:text="●"
        android:textColor="@color/button_on_green"
        android:textSize="28sp"
        app:backgroundTint="@color/primary_green"
        app:cornerRadius="36dp"
        app:strokeColor="@color/white"
        app:strokeWidth="3dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
